#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Start of an implicit (theta-scheme) step, written in increment form:
//   S dT = dt (F - A T^n),   S = M + theta dt A,   T^{n+1} = T^n + dT
// With the initial guess dT = 0 the residual is r0 = f - (dt A) T^n.
// Solving for the increment keeps full fp32 precision in dT, and Dirichlet
// nodes simply get dT = 0 (their rows of dt*A and f are zero).
void main() {
    float accRZ = 0.0;
    float accRR = 0.0;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += gridStride()) {
        float ri = loadF[i] - applyDtA(i);
        float zi = invDiag[i] * ri;
        vx[i] = 0.0;
        vr[i] = ri;
        vz[i] = zi;
        vp[i] = zi;
        accRZ += ri * zi;
        accRR += ri * ri;
    }
    vec4 total = workgroupSum(vec4(accRZ, accRR, 0.0, 0.0));
    if (gl_LocalInvocationIndex == 0u) {
        partials[slot(SLOT_RZ0, gl_WorkGroupID.x)] = total.x;
        partials[slot(SLOT_RR, gl_WorkGroupID.x)] = total.y;
    }
}
